{
  "name": "rean-git",
  "private": true,
  "scripts": {
    "dev": "cd web && python3 -m http.server 4173",
    "sync:en": "./scripts/sync_en_content.sh",
    "sync:km": "./scripts/sync_km_structure.sh",
    "sync": "npm run sync:en && npm run sync:km && npm run sync:site-meta",
    "sync:site-meta": "python3 scripts/check_site_quality.py --write-site-meta",
    "hooks:install": "./scripts/install_git_hooks.sh",
    "check:fast": "./scripts/check_content_sync.sh && ./scripts/check_km_content_sync.sh && ./scripts/check_site_quality.sh",
    "check": "npm run check:fast && ./scripts/run_lab_verifier_fixtures.sh",
    "lint": "eslint web/assets/js tests",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "eslint": "^9.21.0",
    "globals": "^15.15.0"
  }
}
